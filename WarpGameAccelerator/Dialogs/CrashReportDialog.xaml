<!-- ============================================================
     Dialogs/CrashReportDialog.xaml — Hộp thoại Đề Xuất Báo Cáo Sự Cố
     ============================================================ -->
<ContentDialog
    x:Class="WarpGameAccelerator.Dialogs.CrashReportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="⚠️ BÁO CÁO SỰ CỐ ỨNG DỤNG"
    PrimaryButtonText="🚀 Gửi Báo Cáo Lỗi"
    CloseButtonText="Bỏ Qua"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Width="440" Spacing="12" Padding="0,4,0,0">

        <!-- Description -->
        <TextBlock Text="Ở lần sử dụng trước, WARP Game Accelerator đã gặp sự cố đột ngột. Bạn có muốn gửi báo cáo lỗi đến nhà phát triển để phân tích và khắc phục?"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- Crash Info Header -->
        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="6" Padding="10,8">
            <Grid ColumnSpacing="8" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" x:Name="ExceptionTitleText"
                           Text="Lỗi: Exception" FontWeight="SemiBold" FontSize="12"/>

                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TimestampText"
                           Text="2026-07-25" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MessageText"
                           Text="Chi tiết..." FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- StackTrace Box -->
        <TextBlock Text="Chi tiết kỹ thuật (Stack Trace):" FontSize="11" FontWeight="SemiBold"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <TextBox x:Name="StackTraceBox"
                 Height="110"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="10"
                 CornerRadius="6"/>

        <!-- Status Result Text -->
        <TextBlock x:Name="StatusText" Text="" FontSize="11" FontWeight="SemiBold"
                   Foreground="#00E676"/>

    </StackPanel>
</ContentDialog>
