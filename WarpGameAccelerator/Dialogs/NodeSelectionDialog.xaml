<!-- ============================================================
     Dialogs/NodeSelectionDialog.xaml — Hộp thoại Chọn Node Server kiểu GearUP
     ============================================================ -->
<ContentDialog
    x:Class="WarpGameAccelerator.Dialogs.NodeSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CHỌN NODE SERVER CLOUDFLARE"
    PrimaryButtonText="Xác Nhận Chọn Node"
    CloseButtonText="Hủy"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Width="400" Spacing="12" Padding="0,4,0,0">

        <!-- Description -->
        <TextBlock Text="Chọn Node Server tối ưu cho Age of Wushu Taiwan. Mặc định hệ thống tự chọn Node tốt nhất (Auto)."
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- Search Box + Refresh Button -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     PlaceholderText="🔍 Tìm Node (Taiwan, HK...)"
                     CornerRadius="6"
                     TextChanged="SearchBox_TextChanged"/>

            <Button Grid.Column="1"
                    x:Name="RefreshBtn"
                    Content="🔄 Quét Ping"
                    CornerRadius="6"
                    Click="RefreshBtn_Click"/>
        </Grid>

        <!-- Node List Header -->
        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="6,6,0,0" Padding="10,6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="TÊN NODE &amp; TUYẾN ĐỊNH TUYẾN" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="PING (MS)" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- Node ListView -->
        <ListView x:Name="NodeListView"
                  Height="240"
                  SelectionMode="Single"
                  CornerRadius="0,0,6,6"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  SelectionChanged="NodeListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="8" Padding="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <!-- Flag / Icon -->
                        <TextBlock Grid.Column="0" Text="{Binding Flag}"
                                   FontSize="15" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <!-- Name & Route -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding Route}" FontSize="10"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Ping Display -->
                        <Border Grid.Column="2" VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Background="#0FFFFFFF" CornerRadius="4" Padding="6,3">
                            <TextBlock Text="{Binding PingDisplay}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status Bar -->
        <TextBlock x:Name="StatusText" Text="Đã sẵn sàng" FontSize="11"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

    </StackPanel>
</ContentDialog>
