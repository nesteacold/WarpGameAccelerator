<?xml version="1.0" encoding="utf-8"?>
<!--
  MainWindow.xaml — Shell window với Mica backdrop, custom titlebar, NavigationView
-->
<Window
    x:Class="WarpGameAccelerator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WarpGameAccelerator"
    xmlns:views="using:WarpGameAccelerator.Views"
    Title="WARP Game Accelerator">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- Custom titlebar -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ══ CUSTOM TITLEBAR ══════════════════════════════════════ -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Background="Transparent"
              HorizontalAlignment="Stretch">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- Logo -->
                <ColumnDefinition Width="*"/>     <!-- Drag region -->
                <ColumnDefinition Width="Auto"/>  <!-- Status badge -->
                <ColumnDefinition Width="138"/>   <!-- Caption buttons (reserved) -->
            </Grid.ColumnDefinitions>

            <!-- Logo + App Name -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        Spacing="8">
                <Image Source="ms-appx:///Assets/logo.png" Width="24" Height="24" Stretch="UniformToFill"/>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="WARP Game Accelerator"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="AppVersionText"
                               Text="v1.3.1"
                               FontSize="9"
                               Opacity="0.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Connection status badge -->
            <Border x:Name="StatusBadge"
                    Grid.Column="2"
                    CornerRadius="10"
                    Padding="10,3"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Background="#1A00D4FF">
                <TextBlock x:Name="StatusBadgeText"
                           Text="● IDLE"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#888888"/>
            </Border>
        </Grid>

        <!-- ══ NAVIGATION + CONTENT + DEV PANEL (gộp 1 Window) ═══════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DevPanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <NavigationView
                x:Name="NavView"
                Grid.Column="0"
                PaneDisplayMode="LeftCompact"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                CompactModeThresholdWidth="0"
                OpenPaneLength="200"
                ItemInvoked="NavView_ItemInvoked">

                <NavigationView.MenuItems>
                    <NavigationViewItem Tag="dashboard" Content="Dashboard">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE945;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Tag="process" Content="Chọn Game">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE7FC;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItem Tag="multiclient" Content="Multi-Client">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE90F;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Tag="aowbooster" Content="AoW Booster">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="Segoe UI Emoji" Glyph="🚀"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Tag="warpaccount" Content="WARP+ Account">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8D4;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Tag="settings" Content="Cài đặt">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Tag="exit" Content="Thoát (Exit)" Foreground="#FF4444">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE711;" Foreground="#FF4444"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <!-- Frame cho navigation -->
                <Frame x:Name="ContentFrame" />
            </NavigationView>

            <!--
              ══ DEV PANEL (ẩn, chỉ mở qua hotkey Ctrl+Shift+Alt+D + mật khẩu) ══
              LƯU Ý: XAML không hỗ trợ #if DEBUG (chỉ .xaml.cs mới có preprocessor
              C#) — panel này vẫn được compile vào MỌI build, nhưng vô hại: cột
              chứa nó (DevPanelColumn) mặc định Width="0" + Visibility="Collapsed",
              và code-behind duy nhất có thể mở nó (hotkey handler, ShowDeveloperPanel)
              đã nằm trong #if DEBUG ở MainWindow.xaml.cs — ở bản Release không có
              đường nào gọi tới, panel không bao giờ hiện ra.
            -->
            <Border Grid.Column="1"
                    x:Name="DevPanelRoot"
                    Visibility="Collapsed"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header cố định (không cuộn mất) — nút đóng panel luôn thấy được -->
                    <Grid Grid.Row="0" Padding="16,14,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="DEVELOPER PANEL"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       CharacterSpacing="60"/>
                            <TextBlock Text="Ẩn — không public. Đang test, chưa ổn định."
                                       FontSize="10" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <Button x:Name="CloseDevPanelBtn"
                                Grid.Column="1"
                                Width="30" Height="30" Padding="0"
                                CornerRadius="15"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="White"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,0,16,20" Spacing="14">

                        <!-- ══ Kênh VPN cá nhân (multi-profile) ═══════════════ -->
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="10">

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Kênh VPN cá nhân" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border x:Name="PersonalVpnStatusBadge"
                                            Background="#1A888888" CornerRadius="4" Padding="6,1">
                                        <TextBlock x:Name="PersonalVpnStatusText" Text="Inactive" FontSize="11" Foreground="#AAAAAA"/>
                                    </Border>
                                </StackPanel>

                                <ToggleSwitch x:Name="PersonalBoostToggle"
                                              OnContent="Đang chạy"
                                              OffContent="Đã tắt"/>

                                <TextBlock x:Name="PersonalVpnHintText"
                                           Text=""
                                           FontSize="10" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="Collapsed"/>

                                <ListView x:Name="ProfileListView"
                                          SelectionMode="Single"
                                          MaxHeight="160">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="views:PersonalVpnProfileItem">
                                            <Grid Padding="4,4" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="0">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind Endpoint}" FontSize="10" FontFamily="Consolas"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button x:Name="ProfileDeleteBtn" Grid.Column="1" Content="✕" FontSize="10" Padding="6,2"
                                                        Tag="{x:Bind Id}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Button x:Name="ImportConfigBtn"
                                        Content="📂  Import file wg-quick .conf"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="6"/>

                                <TextBlock x:Name="ImportMsg" Text="" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>

                                <StackPanel x:Name="TunnelInfoPanel" Spacing="4" Visibility="Collapsed">
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="Address: "/><Run x:Name="InfoAddressText" FontFamily="Consolas"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="DNS: "/><Run x:Name="InfoDnsText" FontFamily="Consolas"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                                <Run Text="Peer: "/><Run x:Name="InfoPeerKeyText" FontFamily="Consolas"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="Endpoint: "/><Run x:Name="InfoEndpointText" FontFamily="Consolas"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="Allowed IPs: "/><Run x:Name="InfoAllowedIpsText" FontFamily="Consolas"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="⚠️  Chỉ dùng khi máy này VỪA Boost VỪA là WireGuard server (setup test) — tên service KHÔNG bị WireGuardConflictGuard tạm dừng khi Boost:"
                                                   FontSize="10" TextWrapping="Wrap"
                                                   Foreground="#F6961E"/>
                                        <TextBox x:Name="ExcludedTunnelBox"
                                                 PlaceholderText="Tên tunnel (vd: wg_server)"
                                                 FontFamily="Consolas"
                                                 FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="PickProcessBtn"
                                        Content="Chọn process (0)"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="6"/>

                                <TextBlock x:Name="SelectedProcessesText"
                                           Text=""
                                           FontSize="11" TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- ══ Direct Mode MASQUE (Beta) ═══════════════════════ -->
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="10">

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Direct Mode MASQUE" FontSize="13" FontWeight="SemiBold"/>
                                    <Border Background="#1AF6961E" CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="Beta" FontSize="11" Foreground="#F6961E"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="Tài khoản riêng, độc lập hoàn toàn với Direct WireGuard. Không cải thiện upload throttling (ISP DPI) — giữ Beta để tự test."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <ToggleSwitch x:Name="MasqueEngineToggle"
                                              Header="Dùng MASQUE cho traffic game (thay Direct WireGuard)"
                                              OnContent="Đang dùng"
                                              OffContent="Đang tắt"/>

                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <StackPanel Spacing="10">
                                        <TextBox x:Name="MasqueLicenseKeyBox"
                                                 PlaceholderText="License Key MASQUE (XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX)"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 MaxLength="48"
                                                 CornerRadius="6"/>

                                        <Button x:Name="ApplyMasqueKeyBtn"
                                                Content="Áp dụng Key cho MASQUE"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="6"/>

                                        <TextBlock x:Name="MasqueStatusMsg"
                                                   Text=""
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
