<!-- ============================================================
     Views/MultiClientPage.xaml — Màn hình Multi-Client Launcher AOW
     ============================================================ -->
<Page
    x:Class="WarpGameAccelerator.Views.MultiClientPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,32" Spacing="16">

            <!-- Header -->
            <TextBlock Text="MULTI-CLIENT LAUNCHER"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       CharacterSpacing="80"/>

            <!-- Card 1: Thư mục Game -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="🎮  Thư mục Game (Age of Wushu)"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                    <!-- Folder input row -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderPathBox"
                                 Grid.Column="0"
                                 PlaceholderText="C:\Program Files\AOW"
                                 CornerRadius="6"
                                 TextChanged="FolderPathBox_TextChanged"/>
                        <Button Grid.Column="1"
                                x:Name="BrowseBtn"
                                Content="📂"
                                FontSize="16"
                                Width="40" Height="32"
                                CornerRadius="6"
                                Click="BrowseBtn_Click"
                                ToolTipService.ToolTip="Chọn thư mục game"/>
                    </Grid>

                    <!-- Validation status -->
                    <TextBlock x:Name="FolderStatusText"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Nhập hoặc chọn thư mục cài đặt AoW"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Mở nhiều cửa sổ game (tổng số) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="🚀  Mở nhiều cửa sổ game"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Text="Nhập TỔNG số cửa sổ game cần mở rồi bấm MỞ. App sẽ gọi launcher, chờ bạn đăng nhập, rồi tự động mở nốt những cửa sổ còn lại."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- Tổng số cửa sổ -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="−" Width="36" Height="36"
                                x:Name="DecBtn" CornerRadius="6"
                                Click="DecBtn_Click"/>
                        <TextBox Grid.Column="1" x:Name="CountText" Text="2"
                                 Width="56" Height="36"
                                 HorizontalTextAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="15" FontWeight="SemiBold"
                                 CornerRadius="6"
                                 InputScope="Number"
                                 MaxLength="2"
                                 TextChanged="CountText_TextChanged"
                                 LostFocus="CountText_LostFocus"/>
                        <Button Grid.Column="2" Content="+" Width="36" Height="36"
                                x:Name="IncBtn" CornerRadius="6"
                                Click="IncBtn_Click"/>
                        <TextBlock Grid.Column="3" Text="tổng số cửa sổ"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <!-- MỘT nút duy nhất lo trọn quy trình -->
                    <Button x:Name="StartBtn"
                            Content="▶  MỞ 2 CỬA SỔ"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="False"
                            Click="StartBtn_Click"
                            CornerRadius="6"/>

                    <!-- Trạng thái tiến trình -->
                    <Border x:Name="TokenStatusBadge"
                            Background="#1AFF9500"
                            BorderBrush="#33FF9500"
                            BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="TokenDot" Width="8" Height="8"
                                     Fill="#FF9500" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TokenStatusText"
                                       Text="Sẵn sàng — chọn số cửa sổ rồi bấm MỞ"
                                       FontSize="12" VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Token preview -->
                    <Border Background="#0AFFFFFF" CornerRadius="6" Padding="10,8">
                        <TextBlock x:Name="TokenPreviewText"
                                   Text="Token: —"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <TextBlock x:Name="StatusMsg" Text="" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Card 5: Client đang chạy -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RunningHeader"
                                   Grid.Column="0"
                                   Text="📋  Client đang chạy (0)"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="HideAllBtn"
                                Content="Ẩn tất cả"
                                Visibility="Collapsed"
                                FontSize="12" CornerRadius="6"
                                Click="HideAllBtn_Click"
                                ToolTipService.ToolTip="Ẩn hết cửa sổ client đang hiện"/>
                        <Button Grid.Column="2" x:Name="KillAllBtn"
                                Content="Dừng tất cả"
                                Foreground="#FF6666"
                                Visibility="Collapsed"
                                FontSize="12" CornerRadius="6"
                                Click="KillAllBtn_Click"/>
                    </Grid>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" Spacing="4"
                                HorizontalAlignment="Center" Margin="0,8">
                        <TextBlock Text="🎮" FontSize="28"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Chưa có client nào đang chạy"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Client list -->
                    <StackPanel x:Name="ClientListPanel" Spacing="6"
                                Visibility="Collapsed"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
