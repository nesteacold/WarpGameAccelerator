<!-- ============================================================
     Views/MultiClientPage.xaml — Màn hình Multi-Client Launcher AOW
     Bảng nhiều thư mục game: mỗi hàng = 1 thư mục, tự quản lý số cửa sổ và
     danh sách client đang chạy của riêng nó.
     ============================================================ -->
<Page
    x:Class="WarpGameAccelerator.Views.MultiClientPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WarpGameAccelerator.ViewModels"
    xmlns:svc="using:WarpGameAccelerator.Services"
    xmlns:conv="using:WarpGameAccelerator.Converters"
    Background="Transparent">

    <Page.Resources>
        <conv:HasTokenDotConverter x:Key="TokenDot"/>
        <conv:ExpandChevronConverter x:Key="ExpandChevron"/>
        <conv:CountToEmptyVisibilityConverter x:Key="CountEmptyVis"/>
        <conv:CountToVisibilityConverter x:Key="CountVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,32" Spacing="16">

            <!-- Header -->
            <TextBlock Text="MULTI-CLIENT LAUNCHER"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       CharacterSpacing="80"/>

            <!-- Toolbar: quét tự động + thêm tay -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="🎮  Thư mục Game (Age of Wushu)"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <Button Grid.Column="1"
                                x:Name="DiscoverBtn"
                                Content="🔍  Quét tự động"
                                IsEnabled="{x:Bind ViewModel.IsDiscovering, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                Click="DiscoverBtn_Click"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Quét mọi ổ đĩa cố định để tự tìm thư mục cài AOW (có thể mất tới ~1 phút)"/>

                        <Button Grid.Column="2"
                                x:Name="AddFolderBtn"
                                Content="📂  Thêm thư mục"
                                Click="AddFolderBtn_Click"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Thêm tay 1 thư mục nếu quét tự động không thấy"/>
                    </Grid>

                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsDiscovering, Mode=OneWay}"/>

                    <TextBlock Text="{x:Bind ViewModel.DiscoveryStatusText, Mode=OneWay}"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.DiscoveryStatusText, Mode=OneWay, Converter={StaticResource StringToVis}}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Bảng thư mục: mỗi hàng tự quản lý client của riêng mình -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="📋  Danh sách thư mục"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                    <!-- Empty state -->
                    <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,12"
                                Visibility="{x:Bind ViewModel.Folders.Count, Mode=OneWay, Converter={StaticResource CountEmptyVis}}">
                        <TextBlock Text="🎮" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chưa có thư mục nào — bấm Quét tự động hoặc Thêm thư mục"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Folders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameFolderRowViewModel">
                                <Border Background="#0AFFFFFF" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="8">

                                        <!-- Hàng chính -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Chấm trạng thái token RIÊNG của thư mục này (mỗi thư mục
                                                 = 1 tài khoản/phiên đăng nhập độc lập) — xanh = đã có
                                                 token, cam = chưa (lần MỞ GAME kế sẽ đăng nhập lại). -->
                                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                                     VerticalAlignment="Center"
                                                     Fill="{x:Bind HasToken, Mode=OneWay, Converter={StaticResource TokenDot}}"
                                                     ToolTipService.ToolTip="{x:Bind TokenTooltip, Mode=OneWay}"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind ShortPath, Mode=OneWay}"
                                                           FontSize="12" FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Path}"/>
                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{x:Bind StatusText, Mode=OneWay, Converter={StaticResource StringToVis}}"/>
                                            </StackPanel>

                                            <!-- Version badge — best-effort, ẩn hẳn nếu không đọc được -->
                                            <Border Grid.Column="2"
                                                    Background="#1A0078D4" CornerRadius="4" Padding="6,3"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind HasVersion, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind VersionText, Mode=OneWay}" FontSize="11"/>
                                            </Border>

                                            <!-- Badge số client đang chạy / tổng cấu hình -->
                                            <Border Grid.Column="3"
                                                    Background="#1A00C864" CornerRadius="4" Padding="6,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}" FontSize="11"/>
                                            </Border>

                                            <!-- Đếm số cửa sổ muốn mở -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Content="−" Width="28" Height="28" FontSize="12"
                                                        CornerRadius="4" Padding="0"
                                                        Click="DecCount_Click" Tag="{x:Bind}"/>
                                                <TextBox Text="{x:Bind ClientCountText, Mode=OneWay}"
                                                         Width="36" Height="28"
                                                         HorizontalTextAlignment="Center"
                                                         FontSize="12"
                                                         InputScope="Number" MaxLength="2"
                                                         CornerRadius="4"
                                                         LostFocus="CountBox_LostFocus"
                                                         Tag="{x:Bind}"/>
                                                <Button Content="+" Width="28" Height="28" FontSize="12"
                                                        CornerRadius="4" Padding="0"
                                                        Click="IncCount_Click" Tag="{x:Bind}"/>
                                            </StackPanel>

                                            <!-- MỞ GAME + chevron actions -->
                                            <SplitButton Grid.Column="5"
                                                         Content="▶  MỞ GAME"
                                                         IsEnabled="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                                         Click="LaunchSplitButton_Click"
                                                         Tag="{x:Bind}">
                                                <SplitButton.Flyout>
                                                    <MenuFlyout Placement="Bottom">
                                                        <MenuFlyoutItem Text="Ẩn/Hiện tất cả (thư mục này)"
                                                                        Click="HideAllRow_Click" Tag="{x:Bind}"/>
                                                        <MenuFlyoutItem Text="Dừng tất cả (thư mục này)"
                                                                        Click="StopAllRow_Click" Tag="{x:Bind}"/>
                                                        <MenuFlyoutSeparator/>
                                                        <MenuFlyoutItem Text="Xoá khỏi danh sách"
                                                                        Click="RemoveFolderRow_Click" Tag="{x:Bind}"/>
                                                    </MenuFlyout>
                                                </SplitButton.Flyout>
                                            </SplitButton>
                                        </Grid>

                                        <!-- Chevron mở rộng: danh sách client đang chạy của riêng thư mục này -->
                                        <Button Content="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource ExpandChevron}}"
                                                Click="ToggleExpand_Click" Tag="{x:Bind}"
                                                FontSize="11" Padding="6,2" CornerRadius="4"
                                                HorizontalAlignment="Left"
                                                Background="Transparent" BorderThickness="0"
                                                Visibility="{x:Bind RunningCount, Mode=OneWay, Converter={StaticResource CountVis}}"/>

                                        <ItemsControl ItemsSource="{x:Bind RunningClients}"
                                                      Visibility="{x:Bind IsExpanded, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="4" Margin="20,0,0,0"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="svc:RunningClient">
                                                    <Border Background="#10FFFFFF" CornerRadius="4" Padding="8,6">
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Ellipse Grid.Column="0" Width="7" Height="7"
                                                                     Fill="#00C864" VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{x:Bind DisplayText}"
                                                                       FontSize="11" VerticalAlignment="Center"/>

                                                            <Button Grid.Column="2" Content="Ẩn/Hiện"
                                                                    FontSize="10" Height="24" Padding="6,0"
                                                                    CornerRadius="4"
                                                                    Click="HideOne_Click" Tag="{x:Bind}"/>

                                                            <Button Grid.Column="3" Content="Đóng"
                                                                    FontSize="10" Height="24" Padding="6,0"
                                                                    CornerRadius="4" Margin="4,0,0,0"
                                                                    Foreground="#FF6464"
                                                                    Click="KillOne_Click" Tag="{x:Bind}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Client không rõ thư mục — fxgame.exe đang chạy nhưng không khớp thư mục nào đã cấu hình -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16"
                    Visibility="{x:Bind ViewModel.HasUnknownClients, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="⚠️  Client không rõ thư mục"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Các cửa sổ fxgame.exe đang chạy này không khớp thư mục nào trong danh sách trên — có thể mở từ thư mục chưa được thêm/quét ra."
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.UnknownClients}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:RunningClient">
                                <Border Background="#10FFFFFF" CornerRadius="4" Padding="8,6">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind DisplayText}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Đóng"
                                                FontSize="10" Height="24" Padding="6,0"
                                                CornerRadius="4" Foreground="#FF6464"
                                                Click="KillOne_Click" Tag="{x:Bind}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
