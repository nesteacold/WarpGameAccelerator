<?xml version="1.0" encoding="utf-8"?>
<!--
  SettingsPage.xaml — Cài đặt: auto-start, ping target, ngôn ngữ, about
-->
<Page
    x:Class="WarpGameAccelerator.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WarpGameAccelerator.Models"
    xmlns:vm="using:WarpGameAccelerator.ViewModels"
    xmlns:conv="using:WarpGameAccelerator.Converters"
    Background="Transparent">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:DetectedToBrushConverter x:Key="DetectedToBrush"/>
        <conv:DetectedToTextConverter x:Key="DetectedToText"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
    </Page.Resources>

    <ScrollViewer Padding="16,12,16,16">
        <StackPanel Spacing="12">

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Thử endpoint MASQUE" FontSize="15" FontWeight="SemiBold"/>

                    <!-- Dòng trạng thái luôn hiện: 1 dòng khi khớp, cảnh báo khi lệch.
                         MasqueSelectionText/MasqueActiveText giữ lại (Collapsed) không dùng nữa;
                         xem UpdateMasqueSelection() trong code-behind. -->
                    <Border x:Name="MasqueStatusStrip" CornerRadius="6" Padding="10,8" Background="#0AFFFFFF">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="MasqueStatusDot" Width="8" Height="8" CornerRadius="4" Margin="2,3,0,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="MasqueSummaryText" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13"
                                       ToolTipService.ToolTip="Đang chạy = đọc trực tiếp từ MihomoService lúc ghi config.yaml. Đã lưu = ý định người dùng chọn ở bảng bên dưới. Hai giá trị có thể lệch nếu chưa Boost lại sau khi đổi endpoint."/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="MasqueSelectionText" Visibility="Collapsed"/>
                    <TextBlock x:Name="MasqueActiveText" Visibility="Collapsed"/>

                    <Expander x:Name="MasqueAdvancedExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock x:Name="MasqueExpanderHeader" Text="Đo &amp; chọn endpoint khác" FontSize="13"/>
                        </Expander.Header>
                        <StackPanel Spacing="8" Padding="0,8,0,0">
                            <TextBlock Text="Tắt Boost trước khi đo. Colo là vị trí phục vụ HTTP quan sát được (HKG/SIN…), không phải vùng có thể ép chọn hay vị trí ingress đã xác nhận." TextWrapping="Wrap" FontSize="12"/>
                            <Button x:Name="MasqueApplyButton" Content="Dùng endpoint đã chọn" Click="ApplyMasque_Click"
                                    Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="MasqueRetestButton" Content="Đo lại đã chọn" Click="RetestMasque_Click" HorizontalAlignment="Stretch"/>
                                <Button x:Name="MasqueResetButton" Grid.Column="1" Content="Khôi phục mặc định" Click="ResetMasque_Click" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <CheckBox x:Name="MasqueExtendedCheck" Content="Đo mở rộng: thêm port IPv6 và mẫu HTTP/2 TCP"/>
                            <TextBlock Text="Mở rộng thử 76 tổ hợp; không bảo đảm tìm được vùng mới. HTTP/2 có thể giật hơn khi mất gói. HKG = Hong Kong; TPE = Taipei; HAN/SGN = Việt Nam." TextWrapping="Wrap" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="MasqueScanButton" Content="Đo các endpoint" Click="ScanMasque_Click"/>
                                <Button x:Name="MasqueCancelButton" Content="Dừng đo" Click="CancelMasque_Click" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock x:Name="MasqueStatusText" TextWrapping="Wrap" FontSize="12"/>
                            <TextBox x:Name="MasqueColoFilter" PlaceholderText="Lọc colo: HKG, SIN, TPE…" TextChanged="FilterMasque_TextChanged"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MasqueCountText" Text="Hiển thị 0/0 endpoint" VerticalAlignment="Center" FontSize="12"/>
                                <Button x:Name="MasqueSortButton" Grid.Column="1" Content="HTTP ms ↕" Click="SortMasque_Click"
                                        ToolTipService.ToolTip="Bấm để sắp xếp. Trung bình hai mẫu sau khi kết nối; không phải ping game. Lỗi/thiếu số đo nằm cuối."/>
                            </Grid>
                            <TextBlock Text="Cột bên phải: HTTP trung bình lần 2–3. Ví dụ 50 và 51 → 50,5 ms. Lần đầu gồm dựng kết nối nên thường lâu hơn. Các số này không phải ping game." TextWrapping="Wrap" FontSize="11"/>
                            <ListView x:Name="MasqueResults" MaxHeight="320" SelectionMode="Single"
                                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="3" Padding="0,6">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Endpoint}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="HTTP TB" FontSize="10" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding HttpMsText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding DisplaySummary}" TextWrapping="Wrap" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <MenuFlyoutSeparator Margin="-12,4,-12,4"/>

                            <!-- THỬ NGHIỆM, mặc định TẮT — xem MultiCandidateSettings/CLAUDE.md.
                                 Giữ nhiều tunnel MASQUE dự phòng sống cùng lúc, chuyển tunnel mang
                                 traffic game bằng REST API của mihomo thay vì rebuild+restart —
                                 CHƯA kiểm chứng end-to-end với traffic game thật. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="Bật nhiều tunnel dự phòng (thử nghiệm)"
                                           FontWeight="SemiBold" FontSize="13"/>
                                <ToggleSwitch x:Name="MultiCandidateToggle" Grid.Column="1" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Margin="0"
                                              Toggled="MultiCandidateToggle_Toggled"/>
                            </Grid>
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Text="Dựng tối đa 4 tunnel MASQUE cùng lúc từ lịch sử đo ở trên, cho phép đổi tunnel đang mang traffic game mà KHÔNG cần Boost lại (không quay số colo lần nữa). Chưa kiểm chứng ổn định với traffic game thật — chỉ chọn trước khi đăng nhập game, đừng đổi giữa lúc đang chơi."/>

                            <StackPanel x:Name="MultiCandidatePanel" Spacing="8" Visibility="Collapsed">
                                <Button x:Name="MultiCandidateSweepButton" Content="Quét colo các ứng viên"
                                        Click="SweepMultiCandidate_Click" HorizontalAlignment="Stretch"/>
                                <TextBlock x:Name="MultiCandidateStatusText" TextWrapping="Wrap" FontSize="12"/>
                                <ListView x:Name="MultiCandidateResults" SelectionMode="None"
                                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="3" Padding="0,6">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" TextWrapping="Wrap" FontWeight="SemiBold"
                                                               Text="{Binding Title}"/>
                                                    <Button Grid.Column="1" Content="{Binding ButtonLabel}"
                                                            IsEnabled="{Binding CanSelect}"
                                                            Tag="{Binding ProxyName}"
                                                            Click="SelectGamePath_Click"
                                                            ToolTipService.ToolTip="{Binding ButtonTooltip}"/>
                                                </Grid>
                                                <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding DetailText}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ══ Section: Khởi động ════════════════════════════ -->
            <TextBlock Text="{x:Bind Loc.SettSectionStartup, Mode=OneWay}"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="{x:Bind Loc.SettAutoStartTitle, Mode=OneWay}"
                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.AutoStartEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent="" Margin="0"/>
                    </Grid>
                    
                    <MenuFlyoutSeparator Margin="-12,0,-12,0"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                                   FontSize="12" Foreground="#00E676" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,0,8,0"/>
                        <Button Grid.Column="1" VerticalAlignment="Center"
                                Content="{x:Bind Loc.SettBtnCheckUpdate, Mode=OneWay}"
                                Command="{x:Bind ViewModel.CheckUpdateCommand}"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Section: Connection Mode (Engine) ══════════════ -->
            <TextBlock Text="{x:Bind Loc.SettSectionEngine, Mode=OneWay}"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <!-- Direct MASQUE (QUIC/443) — trước đây nằm trong Dev Panel,
                         đưa ra ngoài 2026-08-22 sau khi đo thấy WireGuard/2408 mất
                         kết nối theo cửa sổ mà MASQUE thì không (xem CLAUDE.md
                         mục "Ba engine mode"). -->
                    <RadioButton IsChecked="{x:Bind ViewModel.IsDirectMasqueBeta, Mode=TwoWay}"
                                 GroupName="ConnectionEngineGroup"
                                 ToolTipService.ToolTip="{x:Bind Loc.SettEngineMasqueDesc, Mode=OneWay}"
                                 HorizontalAlignment="Stretch">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="{x:Bind Loc.SettEngineMasqueTitle, Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Loc.SettEngineMasqueDesc, Mode=OneWay}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <MenuFlyoutSeparator Margin="-12,0,-12,0"/>

                    <!-- Direct WireGuard -->
                    <RadioButton IsChecked="{x:Bind ViewModel.IsDirectWireGuard, Mode=TwoWay}"
                                 GroupName="ConnectionEngineGroup"
                                 ToolTipService.ToolTip="{x:Bind Loc.SettEngineDirectDesc, Mode=OneWay}"
                                 HorizontalAlignment="Stretch">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="{x:Bind Loc.SettEngineDirectTitle, Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Loc.SettEngineDirectDesc, Mode=OneWay}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <MenuFlyoutSeparator Margin="-12,0,-12,0"/>

                    <!-- WARP Client Proxy (Compatibility Mode) -->
                    <RadioButton IsChecked="{x:Bind ViewModel.IsWarpClientProxy, Mode=TwoWay}"
                                 GroupName="ConnectionEngineGroup"
                                 ToolTipService.ToolTip="{x:Bind Loc.SettEngineWarpDesc, Mode=OneWay}"
                                 HorizontalAlignment="Stretch">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="{x:Bind Loc.SettEngineWarpTitle, Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{x:Bind Loc.SettEngineWarpDesc, Mode=OneWay}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- ══ Section: Language ═════════════════════════════ -->
            <TextBlock Text="{x:Bind Loc.SettSectionLanguage, Mode=OneWay}"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Loc.SettLangTitle, Mode=OneWay}"
                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Loc.SettLangSubtitle, Mode=OneWay}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="BtnVi"
                                Content="🇻🇳  VIE"
                                Command="{x:Bind ViewModel.SetLanguageViCommand}"
                                CornerRadius="8"
                                Padding="14,8"
                                FontSize="12"/>
                        <Button x:Name="BtnEn"
                                Content="🇺🇸  ENG"
                                Command="{x:Bind ViewModel.SetLanguageEnCommand}"
                                CornerRadius="8"
                                Padding="14,8"
                                FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Section: WARP ════════════════════════════════= -->
            <TextBlock Text="{x:Bind Loc.SettSectionWarp, Mode=OneWay}"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Cloudflare WARP Client"
                                       FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Loc.SettWarpClientSubtitle, Mode=OneWay}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{x:Bind Loc.SettBtnDownload, Mode=OneWay}"
                                Command="{x:Bind ViewModel.OpenCloudflareWarpCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                CornerRadius="8"
                                Padding="14,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Section: Conflict Detection ═══════════════════ -->
            <TextBlock Text="Phát hiện xung đột"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.ConflictItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConflictItemViewModel">
                            <StackPanel Spacing="8" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <Border Background="{x:Bind IsDetected, Mode=OneWay, Converter={StaticResource DetectedToBrush}}"
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind IsDetected, Mode=OneWay, Converter={StaticResource DetectedToText}}"
                                                       FontSize="10" FontWeight="SemiBold" Foreground="White"
                                                       TextWrapping="NoWrap"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind Description}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                  IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                  OnContent="" OffContent="" Margin="0"/>
                                </Grid>
                                <MenuFlyoutSeparator Margin="-12,0,-12,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- ══ Section: Bug Report ═══════════════════════════ -->
            <TextBlock Text="{x:Bind Loc.SettSectionBugReport, Mode=OneWay}"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind Loc.SettBugReportTitle, Mode=OneWay}"
                               FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind Loc.SettBugReportSubtitle, Mode=OneWay}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <TextBlock Text="{x:Bind Loc.SettBugReportCategoryLabel, Mode=OneWay}"
                               FontSize="11" Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.BugReportCategories}"
                              SelectedItem="{x:Bind ViewModel.SelectedBugReportCategory, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              HorizontalAlignment="Stretch"/>

                    <TextBox Text="{x:Bind ViewModel.BugReportDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{x:Bind Loc.SettBugReportDescPlaceholder, Mode=OneWay}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="64" MaxHeight="120"/>
                    <TextBlock Text="{x:Bind ViewModel.BugReportDescError, Mode=OneWay}"
                               FontSize="11" Foreground="#FF5252"
                               Visibility="{x:Bind ViewModel.BugReportDescError, Mode=OneWay, Converter={StaticResource StringToVis}}"/>

                    <Border Background="{ThemeResource CardStrokeColorDefaultBrush}"
                            CornerRadius="6" Padding="8,6">
                        <TextBlock Text="{x:Bind ViewModel.BugReportAttachmentPreview, Mode=OneWay}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="{x:Bind ViewModel.BugReportStatusText, Mode=OneWay}"
                                   FontSize="12" Foreground="#00E676" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,0,8,0"/>
                        <Button Grid.Column="1" VerticalAlignment="Center"
                                Content="{x:Bind Loc.SettBtnSendBugReport, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SendBugReportCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSendBugReport, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Section: About ════════════════════════════════ -->
            <TextBlock Text="{x:Bind Loc.SettSectionAbout, Mode=OneWay}"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App icon -->
                    <Ellipse Grid.Column="0"
                             Width="48" Height="48"
                             Margin="0,0,12,0">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F6961E" Offset="0"/>
                                <GradientStop Color="#FF6B35" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE945;" FontSize="22"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

                    <!-- App info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="WARP Game Accelerator"
                                   FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{x:Bind ViewModel.AppVersion}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Powered by Cloudflare WARP+"
                                   FontSize="11"
                                   Foreground="#F6961E"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
