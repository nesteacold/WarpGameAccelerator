<!-- ============================================================
     Views/WarpAccountPage.xaml — Màn hình quản lý tài khoản WARP+
     ============================================================ -->
<Page
    x:Class="WarpGameAccelerator.Views.WarpAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,32" Spacing="20">

            <!-- Header -->
            <TextBlock Text="WARP+ Account"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       CharacterSpacing="80"/>

            <!-- Status Card -->
            <Border x:Name="StatusCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <!-- Badge icon -->
                        <Border x:Name="AccountBadge" CornerRadius="24"
                                Width="48" Height="48"
                                Background="#1A0078D4">
                            <FontIcon x:Name="AccountIcon"
                                      Glyph="&#xE8D4;" FontSize="22"
                                      Foreground="#0078D4"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="AccountTierText"
                                       Text="WARP Free"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="AccountIdText"
                                       Text="Chưa có tài khoản"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <!-- Nói rõ đây là tài khoản của engine mode nào: mỗi mode
                                 đăng ký thiết bị riêng nên tier có thể khác nhau. -->
                            <TextBlock x:Name="AccountScopeText"
                                       Text=""
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- License Key Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">

                    <TextBlock Text="Nhập License Key WARP+"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Text="Lấy key miễn phí từ app 1.1.1.1 trên điện thoại → Settings → Account → Key"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <TextBox x:Name="LicenseKeyBox"
                             PlaceholderText="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
                             FontFamily="Consolas"
                             FontSize="13"
                             MaxLength="48"
                             CornerRadius="6"/>

                    <Button x:Name="ApplyKeyBtn"
                            Content="Áp dụng Key"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="ApplyKeyBtn_Click"
                            CornerRadius="6"/>

                    <!-- Chỉ hiện khi key sẽ áp vào tài khoản KHÔNG phải tài khoản mà
                         tunnel đang chạy (mode WARP Client Proxy). -->
                    <TextBlock x:Name="KeyScopeWarn"
                               Text=""
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="#E0A030"
                               Visibility="Collapsed"/>

                    <!-- Status Message -->
                    <TextBlock x:Name="StatusMsg"
                               Text=""
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="#0078D4"
                               Visibility="Collapsed"/>

                </StackPanel>
            </Border>

            <!-- Import Account Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">

                    <TextBlock Text="Import tài khoản WARP có sẵn (wgcf)"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                    <TextBlock Text="Nếu bạn đã có tài khoản đăng ký sẵn bằng wgcf (wgcf-account.toml + wgcf-profile.conf), import vào đây để dùng cho Direct Mode."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <TextBlock x:Name="ImportScopeNote"
                               Text=""
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="#E0A030"
                               Visibility="Collapsed"/>

                    <Button x:Name="ImportAccountBtn"
                            Content="📂  Chọn file wgcf-account.toml"
                            HorizontalAlignment="Stretch"
                            Click="ImportAccountBtn_Click"
                            CornerRadius="6"/>

                    <TextBlock x:Name="ImportMsg"
                               Text=""
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                </StackPanel>
            </Border>

            <!-- Reset Section -->
            <Border Background="#0AFF4444"
                    BorderBrush="#33FF4444"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FF6666"/>
                        <TextBlock Text="Gỡ Key / Reset về WARP Free"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FF6666"/>
                    </StackPanel>

                    <TextBlock Text="Dùng khi nhập nhầm key đểu hoặc bị block. Ứng dụng sẽ xóa tài khoản cũ và tự đăng ký tài khoản WARP Free mới hoàn toàn khi kết nối lần sau."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Button x:Name="ResetBtn"
                            Content="🗑️  Xóa Key &amp; Tạo tài khoản mới"
                            HorizontalAlignment="Stretch"
                            Background="#CC3333"
                            Foreground="White"
                            Click="ResetBtn_Click"
                            CornerRadius="6"/>

                    <TextBlock x:Name="ResetMsg"
                               Text=""
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                </StackPanel>
            </Border>

            <!-- Info Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="ℹ️  Lưu ý"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="• WARP Free: Dữ liệu có giới hạn nhưng vẫn tối ưu Ping cho Game."/>
                        <LineBreak/>
                        <Run Text="• WARP+: Dữ liệu không giới hạn và ưu tiên định tuyến tốc độ cao qua Cloudflare."/>
                        <LineBreak/>
                        <Run Text="• Key WARP+ có thể lấy miễn phí bằng cách mời bạn bè dùng app 1.1.1.1."/>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
