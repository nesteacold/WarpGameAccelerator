<?xml version="1.0" encoding="utf-8"?>
<!--
  Styles/AppStyles.xaml — Design system cho toàn bộ app
  Dark-mode gaming: Mica backdrop + orange/cyan accent
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ GLASS CARD ══════════════════════════════════════════
         Dùng cho tất cả card containers
    ══════════════════════════════════════════════════════════ -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#0AFFFFFF"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="#15FFFFFF"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="12"/>
        <Setter Property="Padding"         Value="14,12"/>
    </Style>

    <!-- ══ STAT CARD ═══════════════════════════════════════════
         Nhỏ hơn GlassCard, dùng cho ping / loss / route tiles
    ══════════════════════════════════════════════════════════ -->
    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#0AFFFFFF"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="#12FFFFFF"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="10"/>
        <Setter Property="Padding"         Value="10,10"/>
    </Style>

    <!-- ══ BOOST BUTTON BASE ═══════════════════════════════════
         Override accent button cho màu cam Cloudflare
    ══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"   Color="#F6961E"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E07010"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"  Color="#CC6008"/>

    <!-- NavigationView custom background -->
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>

</ResourceDictionary>
