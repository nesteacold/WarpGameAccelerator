<?xml version="1.0" encoding="utf-8"?>
<!--
  ProcessPickerPage.xaml — Chọn game process để boost
-->
<Page x:ConnectionId='1'
    x:Name="PageRoot"
    x:Class="WarpGameAccelerator.Views.ProcessPickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WarpGameAccelerator.Views"
    xmlns:models="using:WarpGameAccelerator.Models"
    xmlns:conv="using:WarpGameAccelerator.Converters"
    Background="Transparent">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Padding="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Pivot tabs -->
            <RowDefinition Height="Auto"/>  <!-- Info banner -->
        </Grid.RowDefinitions>

        <!-- ══ ROW 0: Header ══════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
            <TextBlock x:ConnectionId='23'                                             
                       FontSize="18" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock x:ConnectionId='24'                                                
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- ══ ROW 1: Pivot ═══════════════════════════════════════ -->
        <Pivot Grid.Row="1" Margin="0,-8,0,0">

            <!-- ─ Tab 1: Game đã biết ─────────────────────────── -->
            <PivotItem x:ConnectionId='3'                                                     >
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:ConnectionId='17'                                                           
                                  Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                                >
                                <Button x:ConnectionId='19' HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,8"
                                        CornerRadius="12"
                                        Padding="16,14"
                                        Command="{Binding ElementName=PageRoot, Path=ViewModel.SelectProfileCommand}"
                                                                   >
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <Border Grid.Column="0"
                                                Width="44" Height="44"
                                                CornerRadius="10"
                                                Background="#20F6961E">
                                            <FontIcon x:ConnectionId='22'                           
                                                      FontSize="22"
                                                      Foreground="#F6961E"/>
                                        </Border>

                                        <!-- Tên game + danh sách exe -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock x:ConnectionId='20'                     
                                                       FontWeight="SemiBold"
                                                       FontSize="14"/>
                                            <TextBlock x:ConnectionId='21'                                  
                                                       FontSize="10"
                                                       Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Arrow -->
                                        <FontIcon Grid.Column="2"
                                                  Glyph="&#xE76C;"
                                                  FontSize="12"
                                                  Opacity="0.5"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </PivotItem>

            <!-- ─ Tab 2: Đang chạy ───────────────────────────── -->
            <PivotItem x:ConnectionId='4'                                                    >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search bar -->
                    <TextBox x:ConnectionId='5' Grid.Row="0"
                             x:Name="SearchBox"
                                                                                                
                                                                                                                   
                             Margin="0,8,0,8"
                             CornerRadius="8"
                             FontSize="13"/>

                    <!-- Process list -->
                    <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="0">
                        <Grid>
                            <!-- Loading state -->
                            <StackPanel x:ConnectionId='9' VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="8"
                                                                                             
                                                                                           >
                                <ProgressRing IsActive="True" Width="32" Height="32"/>
                                <TextBlock x:ConnectionId='16'                                               
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <ListView x:ConnectionId='10' x:Name="ProcessList"
                                                                                           
                                                                                                    
                                      SelectionMode="Single"
                                      IsItemClickEnabled="True"
                                                                       
                                      Padding="4,4,4,4">
                                <ListView.ItemTemplate>
                                    <DataTemplate                                >
                                        <Grid x:ConnectionId='12' Padding="4,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="32" Height="32"
                                                    CornerRadius="6"
                                                    Background="#15FFFFFF">
                                                <FontIcon Glyph="&#xE756;" FontSize="16"
                                                          Foreground="#F6961E"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock x:ConnectionId='14'                            
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:ConnectionId='15'                        
                                                           FontSize="10"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Opacity="0.7"/>
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Background="#10FFFFFF"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="10"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="PID "/>
                                                    <Run x:ConnectionId='13'                          />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Action buttons -->
                    <Grid Grid.Row="2" Margin="0,10,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:ConnectionId='6' Grid.Column="0"
                                                                                    
                                                                           
                                HorizontalAlignment="Stretch"
                                CornerRadius="10"
                                Padding="0,12"
                                FontSize="12"/>
                        <Button x:ConnectionId='7' Grid.Column="1"
                                                                                   
                                                                             
                                HorizontalAlignment="Stretch"
                                CornerRadius="10"
                                Padding="0,12"
                                FontSize="12"/>
                        <Button x:ConnectionId='8' Grid.Column="2"
                                                                                   
                                                                                    
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                CornerRadius="10"
                                Padding="0,12"
                                FontSize="12"/>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- ══ ROW 2: Info Banner ═════════════════════════════════ -->
        <InfoBar x:ConnectionId='2' Grid.Row="2"
                 Severity="Informational"
                 IsOpen="True"
                 IsClosable="False"
                 Title=""
                                                                     
                 CornerRadius="8"/>
    </Grid>
</Page>

