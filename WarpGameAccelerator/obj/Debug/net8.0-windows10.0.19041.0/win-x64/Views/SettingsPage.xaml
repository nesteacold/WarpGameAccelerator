<?xml version="1.0" encoding="utf-8"?>
<!--
  SettingsPage.xaml — Cài đặt: auto-start, ping target, about
-->
<Page x:ConnectionId='1'
    x:Class="WarpGameAccelerator.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WarpGameAccelerator.Models"
    Background="Transparent">

    <ScrollViewer Padding="16,12,16,16">
        <StackPanel Spacing="12">

            <!-- ══ Section: Khởi động ════════════════════════════ -->
            <TextBlock Text="KHỞI ĐỘNG"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Tự động khởi động cùng Windows"
                                       FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="Ứng dụng sẽ khởi chạy khi Windows bật"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='15' Grid.Column="1"
                                                                                             
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Section: Ping Monitor ═════════════════════════ -->
            <TextBlock Text="PING MONITOR"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Server đo Ping"
                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="Chọn IP server để theo dõi độ trễ"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:ConnectionId='9' Grid.Column="0"
                                                                              
                                                                                                   
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate                               >
                                    <StackPanel x:ConnectionId='12'>
                                        <TextBlock x:ConnectionId='13'                      FontWeight="SemiBold"/>
                                        <TextBlock x:ConnectionId='14'                      FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <Button x:ConnectionId='10' Grid.Column="1"
                                                                                    
                                                                                                     
                                ToolTipService.ToolTip="Xóa Server này"
                                Background="Transparent"
                                Foreground="#FF4444"
                                Width="36" Height="36">
                            <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                        </Button>
                    </Grid>

                    <MenuFlyoutSeparator Margin="-12,4,-12,4"/>

                    <TextBlock Text="Thêm Server mới" FontWeight="SemiBold" FontSize="12"/>
                    
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:ConnectionId='4' Grid.Row="0" Grid.Column="0" 
                                 PlaceholderText="Tên (VD: Game VN)"
                                                                                                                           />
                        
                        <TextBox x:ConnectionId='5' Grid.Row="0" Grid.Column="1" 
                                 PlaceholderText="IP (VD: 8.8.8.8)"
                                                                                                                           />

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                    Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <TextBlock x:ConnectionId='6'                                                            
                                       VerticalAlignment="Center" Foreground="#00E676" FontWeight="SemiBold"/>
                                       
                            <Button x:ConnectionId='7' Content="Test IP" 
                                                                                 />
                                    
                            <Button x:ConnectionId='8' Content="+ Thêm" 
                                                                                      
                                    Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Section: WARP ════════════════════════════════= -->
            <TextBlock Text="CLOUDFLARE WARP"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Cloudflare WARP Client"
                                       FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="Mở trang tải về WARP client"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button x:ConnectionId='3' Grid.Column="1"
                                Content="Tải về →"
                                                                                      
                                Style="{StaticResource AccentButtonStyle}"
                                CornerRadius="8"
                                Padding="14,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Section: About ════════════════════════════════ -->
            <TextBlock Text="VỀ ỨNG DỤNG"
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App icon -->
                    <Ellipse Grid.Column="0"
                             Width="48" Height="48"
                             Margin="0,0,12,0">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F6961E" Offset="0"/>
                                <GradientStop Color="#FF6B35" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE945;" FontSize="22"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

                    <!-- App info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="WARP Game Accelerator"
                                   FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:ConnectionId='2'                                     
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Powered by Cloudflare WARP+"
                                   FontSize="11"
                                   Foreground="#F6961E"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

