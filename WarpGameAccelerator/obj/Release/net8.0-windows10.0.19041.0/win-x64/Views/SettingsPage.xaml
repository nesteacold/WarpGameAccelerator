<?xml version="1.0" encoding="utf-8"?>
<!--
  SettingsPage.xaml — Cài đặt: auto-start, ping target, ngôn ngữ, about
-->
<Page x:ConnectionId='1'
    x:Class="WarpGameAccelerator.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WarpGameAccelerator.Models"
    xmlns:conv="using:WarpGameAccelerator.Converters"
    Background="Transparent">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer Padding="16,12,16,16">
        <StackPanel Spacing="12">

            <!-- ══ Section: Khởi động ════════════════════════════ -->
            <TextBlock x:ConnectionId='2'                                                    
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:ConnectionId='30' Grid.Column="0"
                                                                                      
                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <ToggleSwitch x:ConnectionId='31' Grid.Column="1"
                                                                                             
                                      OnContent=""
                                      OffContent=""
                                      Margin="0"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Section: Ping Monitor ═════════════════════════ -->
            <TextBlock x:ConnectionId='3'                                                 
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:ConnectionId='28'                                                     
                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock x:ConnectionId='29'                                                        
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:ConnectionId='22' Grid.Column="0"
                                                                              
                                                                                                   
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate                               >
                                    <StackPanel x:ConnectionId='25'>
                                        <TextBlock x:ConnectionId='26'                      FontWeight="SemiBold"/>
                                        <TextBlock x:ConnectionId='27'                      FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button x:ConnectionId='23' Grid.Column="1"
                                                                                    
                                                                                                     
                                                                                                        
                                Background="Transparent"
                                Foreground="#FF4444"
                                Width="36" Height="36">
                            <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                        </Button>
                    </Grid>

                    <MenuFlyoutSeparator Margin="-12,4,-12,4"/>

                    <TextBlock x:ConnectionId='16'                                                    
                               FontWeight="SemiBold" FontSize="12"/>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:ConnectionId='17' Grid.Row="0" Grid.Column="0"
                                                                                                
                                                                                                                           />

                        <TextBox x:ConnectionId='18' Grid.Row="0" Grid.Column="1"
                                                                                              
                                                                                                                           />

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <TextBlock x:ConnectionId='19'                                                           
                                       VerticalAlignment="Center" Foreground="#00E676" FontWeight="SemiBold"/>

                            <Button x:ConnectionId='20'                                                  
                                                                                 />

                            <Button x:ConnectionId='21'                                               
                                                                                     
                                    Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Section: Language ═════════════════════════════ -->
            <TextBlock x:ConnectionId='4'                                                     
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:ConnectionId='14'                                               
                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock x:ConnectionId='15'                                                  
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:ConnectionId='12' x:Name="BtnVi"
                                Content="🇻🇳  VIE"
                                                                                 
                                CornerRadius="8"
                                Padding="14,8"
                                FontSize="12"/>
                        <Button x:ConnectionId='13' x:Name="BtnEn"
                                Content="🇺🇸  ENG"
                                                                                 
                                CornerRadius="8"
                                Padding="14,8"
                                FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Section: WARP ════════════════════════════════= -->
            <TextBlock x:ConnectionId='5'                                                 
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Cloudflare WARP Client"
                                       FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock x:ConnectionId='11'                                                        
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button x:ConnectionId='10' Grid.Column="1"
                                                                                   
                                                                                      
                                Style="{StaticResource AccentButtonStyle}"
                                CornerRadius="8"
                                Padding="14,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Section: About ════════════════════════════════ -->
            <TextBlock x:ConnectionId='6'                                                  
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App icon -->
                    <Ellipse Grid.Column="0"
                             Width="48" Height="48"
                             Margin="0,0,12,0">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F6961E" Offset="0"/>
                                <GradientStop Color="#FF6B35" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE945;" FontSize="22"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

                    <!-- App info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="WARP Game Accelerator"
                                   FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:ConnectionId='8'                                     
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:ConnectionId='9'                                                        
                                   FontSize="11" Foreground="#00E676" FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button x:ConnectionId='7' Grid.Column="2" VerticalAlignment="Center"
                                                                                  
                                                                           
                            Style="{StaticResource AccentButtonStyle}"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

