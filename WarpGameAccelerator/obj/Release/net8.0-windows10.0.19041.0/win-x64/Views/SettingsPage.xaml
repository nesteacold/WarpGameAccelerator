<?xml version="1.0" encoding="utf-8"?>
<!--
  SettingsPage.xaml — Cài đặt: auto-start, ping target, ngôn ngữ, about
-->
<Page x:ConnectionId='1'
    x:Class="WarpGameAccelerator.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WarpGameAccelerator.Models"
    xmlns:conv="using:WarpGameAccelerator.Converters"
    Background="Transparent">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer Padding="16,12,16,16">
        <StackPanel Spacing="12">

            <!-- ══ Section: Khởi động ════════════════════════════ -->
            <TextBlock x:ConnectionId='2'                                                    
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:ConnectionId='22' Grid.Column="0" VerticalAlignment="Center"
                                                                                      
                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                        <ToggleSwitch x:ConnectionId='23' Grid.Column="1" VerticalAlignment="Center"
                                                                                             
                                      OnContent="" OffContent="" Margin="0"/>
                    </Grid>
                    
                    <MenuFlyoutSeparator Margin="-12,0,-12,0"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:ConnectionId='20' Grid.Column="0" VerticalAlignment="Center"
                                                                                          
                                   FontSize="12" Foreground="#00E676" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,0,8,0"/>
                        <Button x:ConnectionId='21' Grid.Column="1" VerticalAlignment="Center"
                                                                                      
                                                                               
                                Style="{StaticResource AccentButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Section: Connection Mode (Engine) ══════════════ -->
            <TextBlock x:ConnectionId='3'                                                   
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <!-- Direct WireGuard (Super Speed / Recommended) -->
                    <RadioButton x:ConnectionId='14'                                                              
                                 GroupName="ConnectionEngineGroup"
                                                                                                        
                                 HorizontalAlignment="Stretch">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock x:ConnectionId='18'                                                       
                                       FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock x:ConnectionId='19'                                                      
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <MenuFlyoutSeparator Margin="-12,0,-12,0"/>

                    <!-- WARP Client Proxy (Compatibility Mode) -->
                    <RadioButton x:ConnectionId='15'                                                              
                                 GroupName="ConnectionEngineGroup"
                                                                                                      
                                 HorizontalAlignment="Stretch">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock x:ConnectionId='16'                                                     
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:ConnectionId='17'                                                    
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- ══ Section: Language ═════════════════════════════ -->
            <TextBlock x:ConnectionId='4'                                                     
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:ConnectionId='12'                                               
                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock x:ConnectionId='13'                                                  
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:ConnectionId='10' x:Name="BtnVi"
                                Content="🇻🇳  VIE"
                                                                                 
                                CornerRadius="8"
                                Padding="14,8"
                                FontSize="12"/>
                        <Button x:ConnectionId='11' x:Name="BtnEn"
                                Content="🇺🇸  ENG"
                                                                                 
                                CornerRadius="8"
                                Padding="14,8"
                                FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ Section: WARP ════════════════════════════════= -->
            <TextBlock x:ConnectionId='5'                                                 
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Cloudflare WARP Client"
                                       FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock x:ConnectionId='9'                                                        
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button x:ConnectionId='8' Grid.Column="1"
                                                                                   
                                                                                      
                                Style="{StaticResource AccentButtonStyle}"
                                CornerRadius="8"
                                Padding="14,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Section: About ════════════════════════════════ -->
            <TextBlock x:ConnectionId='6'                                                  
                       FontSize="10" FontWeight="SemiBold"
                       CharacterSpacing="150"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,4"/>

            <Border Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App icon -->
                    <Ellipse Grid.Column="0"
                             Width="48" Height="48"
                             Margin="0,0,12,0">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F6961E" Offset="0"/>
                                <GradientStop Color="#FF6B35" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <FontIcon Grid.Column="0"
                              Glyph="&#xE945;" FontSize="22"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

                    <!-- App info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="WARP Game Accelerator"
                                   FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:ConnectionId='7'                                     
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Powered by Cloudflare WARP+"
                                   FontSize="11"
                                   Foreground="#F6961E"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

