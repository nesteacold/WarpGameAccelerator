<?xml version="1.0" encoding="utf-8"?>
<!--
  DashboardPage.xaml — Màn hình chính với BOOST button + real-time stats
-->
<Page x:ConnectionId='1'
    x:Class="WarpGameAccelerator.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WarpGameAccelerator.Views"
    xmlns:vm="using:WarpGameAccelerator.ViewModels"
    xmlns:conv="using:WarpGameAccelerator.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- Converters -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:PingColorConverter x:Key="PingColor"/>

        <!-- Boost button glow animation (Idle) -->
        <Storyboard x:Key="IdleGlowAnim" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="BoostGlow"
                Storyboard.TargetProperty="Opacity"
                From="0.4" To="1.0"
                Duration="0:0:1.5"/>
        </Storyboard>

        <!-- Connected pulse animation -->
        <Storyboard x:Key="ConnectedPulseAnim" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="BoostRingOuter"
                Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0:0:0"   Value="0.8"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1"   Value="0.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="0.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="BoostRingOuter"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="0:0:0"   Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1"   Value="1.4"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.4"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="BoostRingOuter"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="0:0:0"   Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1"   Value="1.4"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.4"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <Grid Padding="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Game info card -->
            <RowDefinition Height="*"/>     <!-- BOOST button area -->
            <RowDefinition Height="Auto"/>  <!-- Stats cards -->
            <RowDefinition Height="Auto"/>  <!-- Ping graph -->
            <RowDefinition Height="Auto"/>  <!-- Status footer -->
        </Grid.RowDefinitions>

        <!-- ══ ROW 0: Game Info Card ══════════════════════════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource GlassCard}"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Game icon placeholder -->
                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="8"
                        Background="#20F6961E"
                        Margin="0,0,12,0">
                    <FontIcon Glyph="&#xE7FC;"
                              FontSize="20"
                              Foreground="#F6961E"/>
                </Border>

                <!-- Game name + path -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:ConnectionId='20' x:Name="SelectedGameName"
                                                                                     
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:ConnectionId='21'                                                         
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Change button -->
                <Button x:ConnectionId='19' Grid.Column="2"
                                                                      
                        Style="{StaticResource AccentButtonStyle}"
                        FontSize="12"
                        Padding="12,6"
                        CornerRadius="8"
                                                      />
            </Grid>
        </Border>

        <!-- ══ ROW 1: BOOST Button ════════════════════════════════ -->
        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <!-- Outer pulse ring (Connected state) -->
            <Ellipse x:ConnectionId='10' x:Name="BoostRingOuter"
                     Width="180" Height="180"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0">
                <Ellipse.Fill>
                    <SolidColorBrush Color="Transparent"/>
                </Ellipse.Fill>
                <Ellipse.Stroke>
                    <SolidColorBrush Color="#00E676"/>
                </Ellipse.Stroke>
                <Ellipse.StrokeThickness>2</Ellipse.StrokeThickness>
                <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"
                                    CenterX="90" CenterY="90"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Middle glow ring -->
            <Ellipse x:ConnectionId='11' x:Name="BoostGlow"
                     Width="156" Height="156"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0.4">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#40F6961E" Offset="0.5"/>
                        <GradientStop Color="#00F6961E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Main BOOST button -->
            <Button x:ConnectionId='12' x:Name="BoostButton"
                    Width="140" Height="140"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="70"
                                                                   
                                                                        
                                                                                       >
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F6961E" Offset="0"/>
                        <GradientStop Color="#E07010" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>

                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <!-- Loading spinner (Connecting) -->
                    <ProgressRing x:ConnectionId='15' x:Name="ConnectingRing"
                                  Width="28" Height="28"
                                  Foreground="White"
                                                                                         
                                                                             
                                                                                                  />
                    <!-- Rocket icon (Idle) -->
                    <FontIcon x:ConnectionId='16' Glyph="&#xE945;"
                              FontSize="32"
                              Foreground="White"
                                                                   
                                                                                              />
                    <!-- Stop icon (Connected) -->
                    <FontIcon x:ConnectionId='17' Glyph="&#xE71A;"
                              FontSize="28"
                              Foreground="White"
                                                                        
                                                                                              />

                    <TextBlock x:ConnectionId='18' x:Name="BoostLabel"
                                                                                      
                               FontWeight="ExtraBold"
                               FontSize="14"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ══ ROW 2: Stats Cards ═════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ping card -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel Spacing="2">
                    <TextBlock Text="PING"
                               FontSize="10"
                               FontWeight="SemiBold"
                               CharacterSpacing="100"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:ConnectionId='6' x:Name="PingValueText"
                               FontSize="22" FontWeight="Bold"
                                                                                 
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:ConnectionId='7' FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                      
                                                                                  >
                        <Run x:ConnectionId='8'                                            />
                        <Run x:ConnectionId='9'                                                       />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Packet Loss card -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel Spacing="2">
                    <TextBlock Text="LOSS"
                               FontSize="10"
                               FontWeight="SemiBold"
                               CharacterSpacing="100"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:ConnectionId='5' FontSize="22" FontWeight="Bold"
                                                                                 
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Packet Loss"
                               FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Route card -->
            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                <StackPanel Spacing="2">
                    <TextBlock Text="ROUTE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               CharacterSpacing="100"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap">
                        <Run Text="WARP+" Foreground="#F6961E"/>
                    </TextBlock>
                    <TextBlock Text="Auto Region"
                               FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ ROW 3: Ping Sparkline Graph ════════════════════════ -->
        <Border Grid.Row="3"
                Style="{StaticResource GlassCard}"
                Margin="0,0,0,12"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="PING HISTORY"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="100"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,6"/>

                <!-- Custom Canvas sparkline - redrawn from code-behind -->
                <Canvas x:ConnectionId='4' x:Name="PingSparkline"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Height="60"
                        Background="Transparent"/>
            </Grid>
        </Border>

        <!-- ══ ROW 4: Status Footer ═══════════════════════════════ -->
        <Border Grid.Row="4"
                CornerRadius="8"
                Padding="12,8"
                Background="#0AFFFFFF">
            <Grid>
                <TextBlock x:ConnectionId='2'                                                  
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- Error message -->
                <InfoBar x:ConnectionId='3' x:Name="ErrorInfoBar"
                         Severity="Error"
                                                                          
                                                                               
                         IsClosable="False"/>
            </Grid>
        </Border>
    </Grid>
</Page>

