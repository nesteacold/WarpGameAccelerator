<?xml version="1.0" encoding="utf-8"?>
<!--
  MainWindow.xaml — Shell window với Mica backdrop, custom titlebar, NavigationView
-->
<Window
    x:Class="WarpGameAccelerator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WarpGameAccelerator"
    Title="WARP Game Accelerator">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- Custom titlebar -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ══ CUSTOM TITLEBAR ══════════════════════════════════════ -->
        <Grid x:ConnectionId='2' x:Name="AppTitleBar"
              Grid.Row="0"
              Background="Transparent"
              HorizontalAlignment="Stretch">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- Logo -->
                <ColumnDefinition Width="*"/>     <!-- Drag region -->
                <ColumnDefinition Width="Auto"/>  <!-- Status badge -->
                <ColumnDefinition Width="138"/>   <!-- Caption buttons (reserved) -->
            </Grid.ColumnDefinitions>

            <!-- Logo + App Name -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        Spacing="8">
                <Ellipse Width="24" Height="24">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F6961E" Offset="0"/>
                            <GradientStop Color="#FF6B35" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="WARP Game Accelerator"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <!-- Connection status badge -->
            <Border x:ConnectionId='5' x:Name="StatusBadge"
                    Grid.Column="2"
                    CornerRadius="10"
                    Padding="10,3"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Background="#1A00D4FF">
                <TextBlock x:ConnectionId='6' x:Name="StatusBadgeText"
                           Text="● IDLE"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#888888"/>
            </Border>
        </Grid>

        <!-- ══ NAVIGATION + CONTENT ════════════════════════════════ -->
        <NavigationView x:ConnectionId='3'
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            CompactModeThresholdWidth="0"
            OpenPaneLength="200"
                                             >

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="dashboard" Content="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="process" Content="Chọn Game">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="settings" Content="Cài đặt">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Frame cho navigation -->
            <Frame x:ConnectionId='4' x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>

